[Unit]
Description=Verified Realtor AI office database snapshot
After=realtor-office.service
Requisite=realtor-office.service

[Service]
Type=oneshot
User=realtor-office
Group=realtor-office
WorkingDirectory=/opt/realtor-office
StateDirectory=realtor-office
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/realtor-office/backups
ExecStart=/opt/realtor-office/deploy/backup.sh /var/lib/realtor-office
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
